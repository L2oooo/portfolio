---
/*
 * BottomBar — floating pill navigation of the wall.
 * Each item is a real link to a card ("#node-projects"): without JS, or in
 * list view, it simply scrolls to the card. In wall view, src/scripts/wall.ts
 * intercepts the click and flies the camera there instead.
 * The view toggle (wall <-> list) needs JS, so it starts hidden.
 */
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);

const items = [
  { target: 'node-leo', label: t('bar.leo'), origin: true },
  { target: 'node-projects', label: t('bar.projects'), origin: false },
  { target: 'node-background', label: t('bar.background'), origin: false },
  { target: 'node-skills', label: t('bar.skills'), origin: false },
  { target: 'node-contact', label: t('bar.contact'), origin: false },
];
---

<nav class="bar" aria-label={t('bar.label')} data-wall-bar>
  <ul role="list">
    {items.map((item, i) => (
      <li>
        <a href={`#${item.target}`} data-target={item.target} class:list={['item', { origin: item.origin }]}>
          {item.origin ? (
            <span class="origin-mark" aria-hidden="true"></span>
          ) : (
            <span class="num" aria-hidden="true">{String(i).padStart(2, '0')}</span>
          )}
          <span class="label">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <span class="sep" aria-hidden="true"></span>
  <button
    type="button"
    class="item toggle"
    data-view-toggle
    data-label-list={t('bar.list')}
    data-label-wall={t('bar.wall')}
    aria-pressed="false"
    hidden
  >
    <span class="toggle-icon" aria-hidden="true"></span>
    <span class="label" data-view-label>{t('bar.list')}</span>
  </button>
</nav>

<style>
  .bar {
    position: fixed;
    left: 50%;
    bottom: max(var(--space-3), env(safe-area-inset-bottom));
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    max-width: calc(100vw - 2 * var(--space-3));
    padding: var(--space-1);
    translate: -50% 0;
    border: var(--line) solid var(--c-line-strong);
    border-radius: 999px;
    /* Translucent + blur: stays readable when cards slide underneath */
    background: color-mix(in srgb, var(--c-surface) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow:
      inset 0 1px 0 var(--glass-rim-hi),
      0 8px 30px rgb(0 0 0 / 0.25);
  }

  ul {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    margin: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none; /* on very narrow screens the items scroll sideways */
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding-inline: var(--space-3);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    white-space: nowrap;
    text-decoration: none;
    color: var(--c-text-muted);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .item:hover {
    color: var(--c-text);
    background: var(--c-line);
  }

  /* The card nearest to the screen center (set by the wall script) */
  .item[aria-current='true'] {
    color: var(--c-text);
    background: var(--c-line);
  }

  .item[aria-current='true']::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--c-accent);
  }

  .origin-mark {
    width: 9px;
    height: 9px;
    background: var(--c-text);
  }

  .origin[aria-current='true']::before {
    display: none; /* the origin already has its own square */
  }

  .sep {
    flex: none;
    width: var(--line);
    height: 24px;
    background: var(--c-line-strong);
  }

  .toggle-icon {
    width: 12px;
    height: 10px;
    border-block: 1.5px solid currentColor;
    background: linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat;
  }

  .toggle[aria-pressed='true'] .toggle-icon {
    /* wall view icon: a small grid of tiles */
    border: 0;
    background:
      linear-gradient(currentColor, currentColor) 0 0 / 5px 4px no-repeat,
      linear-gradient(currentColor, currentColor) 100% 0 / 5px 4px no-repeat,
      linear-gradient(currentColor, currentColor) 0 100% / 5px 4px no-repeat,
      linear-gradient(currentColor, currentColor) 100% 100% / 5px 4px no-repeat;
  }

  .num {
    display: none; /* node numbers only show on narrow screens */
  }

  /*
   * Narrow phones: each item shows only its node number ("02"), except the
   * current one which also shows its name. Hidden names stay readable by
   * screen readers (visually-hidden, not display: none).
   */
  @media (max-width: 479px) {
    .num {
      display: inline;
    }

    .item:not([aria-current='true']) .label,
    .toggle .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .item {
      padding-inline: var(--space-2);
    }

    .item[aria-current='true']::before {
      display: none; /* the expanded name is enough of a marker */
    }

    .item[aria-current='true'] .num {
      color: var(--c-accent);
    }
  }
</style>
