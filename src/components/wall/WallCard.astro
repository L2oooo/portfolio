---
/*
 * WallCard — a detailed card with a node header ("node: 03 · projet"), an
 * optional visual area (named slot "visual") and a body (default slot).
 * Used for the project cards of the projects page. Uses the shared ".glass"
 * style (src/styles/global.css).
 */
import type { Domain } from '../../data/domains';

export type CardKind = 'project';

interface Props {
  id: string;
  kind: CardKind;
  node: number;
  label: string; // header label, e.g. "projet"
  meta?: string; // right side of the header, e.g. a year
  domains?: Domain[];
  class?: string;
}

const { id, kind, node, label, meta, domains = [], class: className } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---

<article
  id={id}
  class:list={['card', 'glass', `card--${kind}`, className]}
  data-kind={kind}
  data-domains={domains.join(' ') || undefined}
>
  <header class="card-head mono">
    <span>node: {String(node).padStart(2, '0')} · {label}</span>
    {meta && <span>{meta}</span>}
  </header>

  {hasVisual && (
    <div class="card-visual">
      <slot name="visual" />
    </div>
  )}

  <div class="card-body">
    <slot />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--line) solid var(--c-line);
  }

  .card-visual {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: var(--line) solid var(--c-line);
  }

  .card-visual :global(img),
  .card-visual :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: var(--space-4);
  }
</style>
