---
/*
 * Wall — the 5 real tiles of the home page, in reading order:
 * Léo → Projects → Background → Skills → Contact. Each one is a full-bleed
 * visual + title + subtitle linking to its section page.
 * This HTML is the "list view": complete and readable without JavaScript.
 * With JavaScript (src/scripts/wall.ts), the tiles are cloned and recycled
 * into an infinite, draggable, curved wall that fills the screen.
 */
import WallTile from './WallTile.astro';
import BlueprintPlaceholder from './BlueprintPlaceholder.astro';
import TopologyMap from '../TopologyMap.astro';
import BottomBar from './BottomBar.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { sectionPath } from '../../i18n/routes';
import { getProjects } from '../../lib/content';
import { buildGraph } from '../../data/graph';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const projectCount = String(projects.length).padStart(2, '0');
---

<div class="wall" data-wall>
  <div class="plane" data-plane>
    <WallTile
      id="node-leo"
      section="about"
      heading="h1"
      title="Léo Salvayre"
      subtitle={t('tile.leo')}
      href={sectionPath(lang, 'about')}
    >
      <BlueprintPlaceholder slot="visual" seed="leo-salvayre" label="portrait" />
    </WallTile>

    <WallTile
      id="node-projects"
      section="projects"
      title={t('hub.title')}
      subtitle={t('tile.projects').replace('{n}', projectCount)}
      href={sectionPath(lang, 'projects')}
    >
      <div slot="visual" class="mosaic">
        {projects.slice(0, 6).map((p) => <BlueprintPlaceholder seed={p.slug} />)}
      </div>
    </WallTile>

    <WallTile
      id="node-background"
      section="background"
      title={t('background.title')}
      subtitle={t('tile.background')}
      href={sectionPath(lang, 'background')}
    >
      <BlueprintPlaceholder slot="visual" seed="parcours-traceroute" label="traceroute" />
    </WallTile>

    <WallTile
      id="node-skills"
      section="skills"
      title={t('skills.title')}
      subtitle={t('tile.skills')}
      href={sectionPath(lang, 'skills')}
    >
      <div slot="visual" class="map-visual">
        <TopologyMap lang={lang} graph={buildGraph([])} compact />
      </div>
    </WallTile>

    <WallTile
      id="node-contact"
      section="contact"
      title={t('card.contact')}
      subtitle={t('tile.contact')}
      href={sectionPath(lang, 'contact')}
    >
      <BlueprintPlaceholder slot="visual" seed="contact-signal" label="signal" />
    </WallTile>
  </div>
</div>

<BottomBar lang={lang} />

<script>
  import { initWall } from '../../scripts/wall';
  initWall();
</script>

<style>
  /* ---- List view (no JS, or the "List" toggle): a simple grid of the 5 tiles ---- */
  .wall {
    --tile-w: 250px; /* tile width on the wall (phones): neighbours peek in from the sides */
    --tile-gap: 16px; /* space between tiles on the wall */
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-6) var(--gutter);
  }

  @media (min-width: 900px) {
    .wall {
      --tile-w: 520px;
      --tile-gap: 32px;
    }
  }

  .plane {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
  }

  /* Leave room so the floating bar never covers the last lines */
  :global(body:has(.wall:not(.is-wall))) {
    padding-bottom: 72px;
  }

  /* ---- Wall view (class added by src/scripts/wall.ts) ---- */
  .wall.is-wall {
    position: relative;
    max-width: none;
    height: calc(100dvh - 61px); /* the first screen, minus the header */
    padding: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none; /* the wall handles touch gestures itself */
    user-select: none; /* dragging over text must not select it */
  }

  .wall.is-dragging {
    cursor: grabbing;
  }

  /* While dragging, links must not react to the pointer */
  .wall.is-dragging .plane {
    pointer-events: none;
  }

  .is-wall .plane {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* Every tile (real or clone) is placed by the script with a transform */
  .is-wall .plane > :global(.tile) {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--tile-w);
    will-change: transform;
  }

  /* ---- Tile visuals ---- */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 1px; /* the gaps show the line color: a fine grid between thumbnails */
    background: var(--c-line);
  }

  /* Placeholder labels would show through under the subtitle */
  .plane :global(.tile .tag) {
    display: none;
  }

  .map-visual {
    display: grid;
    place-items: center;
    padding: 3% 24% 36%; /* keep the map in the upper part, clear of the title */
    background: var(--c-surface);
  }
</style>
