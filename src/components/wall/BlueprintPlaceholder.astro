---
/*
 * BlueprintPlaceholder — a generated "technical drawing" used as a card visual
 * until the real (AI-generated) image exists.
 * Deterministic: the same seed (e.g. a project slug) always draws the same
 * schematic, so each card has a stable, unique look. Pure SVG, built at
 * compile time, decorative only (aria-hidden).
 */

interface Props {
  seed: string;
  label?: string;
}

const { seed, label = seed } = Astro.props;

// Tiny deterministic PRNG (mulberry32) seeded from a string hash
function hash(str: string): number {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function prng(seedValue: number): () => number {
  let a = seedValue;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = prng(hash(seed));
const snap = (v: number): number => Math.round(v / 10) * 10; // stick to a 10-unit grid
const between = (min: number, max: number): number => snap(min + rand() * (max - min));

const W = 320;
const H = 200;

// 3 to 4 boxes laid out left to right, joined by orthogonal connectors
const boxCount = 3 + Math.floor(rand() * 2);
const slot = (W - 40) / boxCount;
const boxes = Array.from({ length: boxCount }, (_, i) => {
  const w = between(40, Math.min(80, slot - 14));
  const h = between(30, 70);
  const x = snap(20 + i * slot + rand() * (slot - w - 10));
  const y = between(30, H - h - 50);
  return { x, y, w, h };
});

const connectors = boxes.slice(1).map((b, i) => {
  const a = boxes[i]!;
  const x1 = a.x + a.w;
  const y1 = a.y + a.h / 2;
  const x2 = b.x;
  const y2 = b.y + b.h / 2;
  const mid = snap((x1 + x2) / 2);
  return `M${x1} ${y1} H${mid} V${y2} H${x2}`;
});

const accentBox = boxes[Math.floor(rand() * boxes.length)]!;
const circle = { cx: between(60, W - 60), cy: between(H - 60, H - 40), r: between(10, 20) };
const dim = { x1: boxes[0]!.x, x2: boxes[boxes.length - 1]!.x + boxes[boxes.length - 1]!.w, y: 18 };
---

<div class="placeholder" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
  <!-- Dimension line across the whole assembly -->
  <g class="dim">
    <line x1={dim.x1} y1={dim.y} x2={dim.x2} y2={dim.y} />
    <line x1={dim.x1} y1={dim.y - 4} x2={dim.x1} y2={dim.y + 4} />
    <line x1={dim.x2} y1={dim.y - 4} x2={dim.x2} y2={dim.y + 4} />
    <text x={(dim.x1 + dim.x2) / 2} y={dim.y - 5} text-anchor="middle">{dim.x2 - dim.x1}</text>
  </g>

  {connectors.map((d) => <path d={d} class="wire" />)}
  {boxes.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} class="box" />)}
  <rect x={accentBox.x + 4} y={accentBox.y + 4} width="6" height="6" class="signal" />

  <circle cx={circle.cx} cy={circle.cy} r={circle.r} class="box" />
  <line x1={circle.cx - circle.r - 5} y1={circle.cy} x2={circle.cx + circle.r + 5} y2={circle.cy} class="axis" />
  <line x1={circle.cx} y1={circle.cy - circle.r - 5} x2={circle.cx} y2={circle.cy + circle.r + 5} class="axis" />

</svg>
<span class="tag">{label.toUpperCase()}</span>
</div>

<style>
  /* The drawing is centered (never cropped); the grid fills the whole area */
  .placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: var(--c-surface);
    background-image:
      linear-gradient(var(--c-grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-grid-major) 1px, transparent 1px);
    background-size: 16px 16px;
    background-position: center;
  }

  .placeholder svg {
    width: 100%;
    height: 100%;
  }


  .box {
    fill: var(--c-bg);
    stroke: var(--c-text-muted);
    stroke-width: 1;
  }

  .wire {
    fill: none;
    stroke: var(--c-text-muted);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .axis,
  .dim line {
    stroke: var(--c-line-strong);
    stroke-width: 0.75;
  }

  .dim text {
    font-family: var(--font-mono);
    fill: var(--c-text-muted);
  }

  .dim text {
    font-size: 7px;
  }

  .tag {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
  }

  .signal {
    fill: var(--c-accent);
  }
</style>
