---
/*
 * HomePage — the home page content, shared by "/" (fr) and "/en/" (en):
 * header, the card wall, and the drawing's title block.
 */
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import TitleBlock from '../TitleBlock.astro';
import Wall from '../wall/Wall.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base title={t('meta.title')} description={t('meta.description')} lang={lang}>
  <Header lang={lang} annotation={t('map.fig')} />
  <main>
    <Wall lang={lang} />
  </main>
  <TitleBlock lang={lang} />
</Base>
