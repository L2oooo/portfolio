---
/*
 * ThemeToggle — switches between the "ink" (dark) and "paper" (light) themes.
 * Writes the choice to <html data-theme> and remembers it in localStorage.
 * Translated strings are passed through data-* attributes because the
 * client-side script has no access to the server-side dictionary.
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button
  class="theme-toggle mono"
  type="button"
  data-theme-toggle
  data-ink={t('theme.ink')}
  data-paper={t('theme.paper')}
  data-to-dark={t('theme.toDark')}
  data-to-light={t('theme.toLight')}
>
  <span class="label">{t('theme.label')}:</span>
  <span class="value" data-theme-value>{t('theme.ink')}</span>
  <span class="swatch" aria-hidden="true"></span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const valueEl = document.querySelector<HTMLSpanElement>('[data-theme-value]');
  const root = document.documentElement;

  type Theme = 'light' | 'dark';

  const render = (theme: Theme): void => {
    if (!button || !valueEl) return;
    const { ink = '', paper = '', toDark = '', toLight = '' } = button.dataset;
    valueEl.textContent = theme === 'light' ? paper : ink;
    button.setAttribute('aria-label', theme === 'light' ? toDark : toLight);
  };

  const current = (): Theme => (root.dataset.theme === 'light' ? 'light' : 'dark');

  render(current());

  button?.addEventListener('click', () => {
    const next: Theme = current() === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage blocked: the choice simply won't persist */
    }
    render(next);
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px; /* comfortable touch target */
    padding-inline: var(--space-3);
    border: var(--line) solid var(--c-line);
    border-radius: var(--radius);
    color: var(--c-text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    border-color: var(--c-line-strong);
    color: var(--c-text);
  }

  .value {
    color: var(--c-text);
    min-width: 6ch;
    text-align: left;
  }

  /* Small screens: keep only the value, the header has little room */
  @media (max-width: 599px) {
    .label {
      display: none;
    }
  }

  /* Half-filled square: shows both themes at a glance */
  .swatch {
    width: 10px;
    height: 10px;
    border: var(--line) solid var(--c-text);
    background: linear-gradient(135deg, var(--c-text) 50%, transparent 50%);
  }
</style>
