---
/*
 * LangSwitch — "FR / EN" links pointing to the same page in each language.
 * Real links (not a JS toggle) so search engines and no-JS visitors can follow them.
 */
import { languages, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/routes';

interface Props {
  lang: Lang;
  label: string;
}

const { lang, label } = Astro.props;
const codes = Object.keys(languages) as Lang[];
---

<nav class="lang-switch mono" aria-label={label}>
  {codes.map((code, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">/</span>}
      <a
        href={localizedPath(code, Astro.url.pathname)}
        hreflang={code}
        lang={code}
        aria-current={code === lang ? 'true' : undefined}
        title={languages[code]}
      >
        {code.toUpperCase()}
      </a>
    </>
  ))}
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
  }

  a {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
    color: var(--c-text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  a:hover {
    color: var(--c-text);
  }

  /* Current language: full color + accent underline, like a selected layer */
  a[aria-current='true'] {
    color: var(--c-text);
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 2px;
  }

  .sep {
    color: var(--c-line-strong);
  }
</style>
