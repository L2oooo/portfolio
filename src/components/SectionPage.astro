---
/*
 * SectionPage — shared layout of every section page (about, projects,
 * background, skills, contact): header, a head panel that looks like the
 * wall card "opened", a "back to the wall" link, then the section content.
 * The head panel shares the view-transition name of its wall card
 * ("card-<section>"), so clicking a card visually turns it into this page.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import TitleBlock from './TitleBlock.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { SECTION_NODE, type Section } from '../i18n/routes';

interface Props {
  lang: Lang;
  section: Section;
  node: number; // node number shown in the head bar ("node: 02")
  label: string; // head bar label, e.g. "parcours"
  title: string;
  intro: string;
  meta?: string; // right side of the head bar, e.g. a count
}

const { lang, section, node, label, title, intro, meta } = Astro.props;
const t = useTranslations(lang);
// Back to the wall, centered on this section's card (see src/scripts/wall.ts)
const backHref = `${getRelativeLocaleUrl(lang, '')}#${SECTION_NODE[section]}`;
---

<Base title={`${title} — Léo Salvayre`} description={intro} lang={lang}>
  <Header lang={lang} annotation={`fig.${String(node + 1).padStart(2, '0')} — ${label}`} />

  <main class="page">
    <section class="head" style={`view-transition-name: card-${section}`} aria-labelledby="section-title">
      <div class="head-bar mono">
        <span>node: {String(node).padStart(2, '0')} · {label}</span>
        {meta && <span>{meta}</span>}
      </div>
      <div class="head-body">
        <a href={backHref} class="back mono">← {t('projects.back')}</a>
        <h1 id="section-title">{title}</h1>
        <p class="intro">{intro}</p>
        <slot name="head" />
      </div>
    </section>

    <slot />
  </main>

  <TitleBlock lang={lang} />
</Base>

<style>
  .page {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) var(--space-8);
  }

  /* Same look as a wall card: it is the card, "opened" */
  .head {
    margin-bottom: var(--space-6);
    background: var(--c-surface);
    border: var(--line) solid var(--c-line-strong);
    border-radius: 12px;
  }

  .head-bar {
    display: flex;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--line) solid var(--c-line);
  }

  .head-body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4) var(--space-6);
  }

  .back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--c-text-muted);
  }

  .back:hover {
    color: var(--c-accent);
  }

  h1 {
    font-size: var(--fs-display);
  }

  .intro {
    max-width: 48ch;
    font-size: var(--fs-lg);
    color: var(--c-text-muted);
  }
</style>
