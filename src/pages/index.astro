---
/*
 * Home page — TEMPORARY design-system specimen ("fig.00").
 * Lets us judge colors, typography, lines and both themes before building
 * the real topology map. Will be replaced at step 5.
 */
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const swatches = [
  { name: 'bg', token: '--c-bg', note: 'encre / papier' },
  { name: 'surface', token: '--c-surface', note: 'panneaux' },
  { name: 'line', token: '--c-line', note: 'traits' },
  { name: 'text', token: '--c-text', note: 'texte' },
  { name: 'muted', token: '--c-text-muted', note: 'annotations' },
  { name: 'accent', token: '--c-accent', note: 'signal' },
];

const scale = [
  { label: 'display', size: 'var(--fs-xl)', stretch: 'var(--stretch-display)', text: 'IA × CYBER × PRODUIT' },
  { label: 'lg', size: 'var(--fs-lg)', stretch: 'var(--stretch-body)', text: 'Ingénieur hybride, entre sécurité, agents IA et produit.' },
  { label: 'base', size: 'var(--fs-base)', stretch: 'var(--stretch-body)', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.' },
];
---

<Base title="Léo Salvayre — fig.00" description="Planche de design system du portfolio.">
  <header class="topbar">
    <span class="mono">LS / portfolio</span>
    <span class="mono hide-sm">fig.00 — design system</span>
    <ThemeToggle />
  </header>

  <main class="sheet">
    <section class="hero" aria-labelledby="hero-title">
      <p class="mono annot">node: 00 · root</p>
      <h1 id="hero-title">Léo<br />Salvayre<span class="dot" aria-hidden="true"></span></h1>
      <div class="hero-meta">
        <p class="mono"><span class="status" aria-hidden="true"></span>status: open to work</p>
        <p class="mono">loc: Paris, FR</p>
        <p class="mono">links: 4 domains · 12 nodes</p>
      </div>
    </section>

    <section class="block" aria-labelledby="color-title">
      <header class="block-head">
        <span class="mono">01</span>
        <h2 id="color-title">Couleur</h2>
      </header>
      <ul class="swatches">
        {swatches.map((s) => (
          <li>
            <span class="chip" style={`background: var(${s.token})`}></span>
            <span class="mono">{s.name}</span>
            <span class="mono faint">{s.note}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="type-title">
      <header class="block-head">
        <span class="mono">02</span>
        <h2 id="type-title">Typographie</h2>
      </header>
      <dl class="scale">
        {scale.map((row) => (
          <div class="scale-row">
            <dt class="mono">{row.label}</dt>
            <dd style={`font-size: ${row.size}; font-stretch: ${row.stretch}`}>{row.text}</dd>
          </div>
        ))}
        <div class="scale-row">
          <dt class="mono">mono</dt>
          <dd class="mono specimen-mono">fig.01 — node: 12 — lens: cyber — status: open</dd>
        </div>
      </dl>
    </section>

    <section class="block" aria-labelledby="line-title">
      <header class="block-head">
        <span class="mono">03</span>
        <h2 id="line-title">Trait &amp; nœuds</h2>
      </header>
      <!-- Preview of the map vocabulary: nodes, links, active path -->
      <svg class="mini-map" viewBox="0 0 600 180" role="img" aria-label="Aperçu du langage graphique de la carte">
        <line x1="60" y1="90" x2="300" y2="90" class="link" />
        <line x1="300" y1="90" x2="540" y2="40" class="link active" />
        <line x1="300" y1="90" x2="540" y2="140" class="link" />
        <circle cx="60" cy="90" r="6" class="node" />
        <rect x="288" y="78" width="24" height="24" class="node root" />
        <circle cx="540" cy="40" r="6" class="node active" />
        <circle cx="540" cy="140" r="6" class="node" />
        <text x="60" y="122" class="label" text-anchor="middle">IA</text>
        <text x="300" y="130" class="label" text-anchor="middle">LÉO</text>
        <text x="540" y="22" class="label active" text-anchor="middle">CYBER</text>
        <text x="540" y="172" class="label" text-anchor="middle">DEV</text>
      </svg>
    </section>
  </main>

  <footer class="titleblock">
    <span class="mono">drawn by: L. Salvayre</span>
    <span class="mono">rev: 0.1</span>
    <span class="mono">scale: 1:1</span>
  </footer>
</Base>

<style>
  .topbar,
  .titleblock {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--gutter);
    border-bottom: var(--line) solid var(--c-line);
  }

  .titleblock {
    border-top: var(--line) solid var(--c-line);
    border-bottom: 0;
    margin-top: var(--space-8);
  }

  .sheet {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding-block: var(--space-8) var(--space-7);
    border-bottom: var(--line) solid var(--c-line);
  }

  .hero h1 {
    font-size: var(--fs-display);
    font-weight: 800;
    margin-block: var(--space-3) var(--space-5);
  }

  .dot {
    display: inline-block;
    width: 0.14em;
    height: 0.14em;
    margin-left: 0.04em;
    background: var(--c-accent);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .status {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--c-accent);
    animation: pulse 2.4s var(--ease-out) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  /* ---- Blocks ---- */
  .block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-bottom: var(--line) solid var(--c-line);
  }

  @media (min-width: 900px) {
    .block {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }

  .block-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .block-head h2 {
    font-size: var(--fs-xl);
  }

  /* ---- Swatches ---- */
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: grid;
    gap: var(--space-1);
  }

  .chip {
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-2);
    border: var(--line) solid var(--c-line-strong);
  }

  .faint {
    opacity: 0.7;
  }

  /* ---- Type scale ---- */
  .scale {
    display: grid;
    gap: var(--space-4);
  }

  .scale-row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-bottom: var(--space-4);
    border-bottom: var(--line) dashed var(--c-line);
  }

  .scale-row:last-child {
    border-bottom: 0;
  }

  .scale-row dd {
    max-width: 60ch;
  }

  .specimen-mono {
    font-size: var(--fs-sm);
    color: var(--c-text);
  }

  /* ---- Mini map ---- */
  .mini-map {
    width: 100%;
    max-width: 40rem;
    overflow: visible;
  }

  .link {
    stroke: var(--c-line-strong);
    stroke-width: 1;
  }

  .link.active {
    stroke: var(--c-accent);
    stroke-dasharray: 6 4;
    animation: flow 1.2s linear infinite;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -20;
    }
  }

  .node {
    fill: var(--c-bg);
    stroke: var(--c-text);
    stroke-width: 1.5;
  }

  .node.root {
    fill: var(--c-text);
  }

  .node.active {
    fill: var(--c-accent);
    stroke: var(--c-accent);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--c-text-muted);
  }

  .label.active {
    fill: var(--c-accent);
  }

  @media (max-width: 599px) {
    .hide-sm {
      display: none;
    }
  }
</style>
